    "editor.selectionBackground": "#004377",
    "editor.inactiveSelectionBackground": "#565656",
    "editor.selectionHighlightBackground": "#3D3D3D",
    "editor.wordHighlightBackground": "#0E4583",
    "editor.wordHighlightStrongBackground": "#0E4583",
    "editor.findMatchBackground": "#773800",
